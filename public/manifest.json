{
  "manifest_version": 3,
  "name": "Browser Companion",
  "version": "0.1.0",
  "description": "유튜브 자막과 현재 화면을 참고해 질문하고 토의하는 학습 도우미",
  "action": {
    "default_title": "Browser Companion 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.openai.com/*"]
}
