{
  "manifest_version": 3,
  "name": "Browser Companion",
  "version": "0.1.0",
  "description": "유튜브 영상에 들어가면 전체 자막을 준비하는 학습 도우미",
  "action": {
    "default_title": "Browser Companion 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["https://www.youtube.com/*"]
}
